# dependencies
node_modules/

# build output
dist/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor / OS / tooling
.DS_Store
.vscode/
.idea/

# design-reference input only — third-party inspiration imagery, not part of the
# app and not cleared for redistribution. Keep local; do not publish.
reference-samples/

# local verification scratch — screenshots, probe output, throwaway scripts
scratchpad/

# rendered verification frames from scripts/shoot-output.mjs. Same category as
# scratchpad/ and it was simply missed: these are throwaway evidence for judging
# a layout at 1920x1080, regenerated on demand, and 300KB each. They were tracked
# for seven commits before anyone noticed.
out/

# ASR benchmark byproducts. The harness in scripts/asr-benchmark IS committed; what
# it produces never is — model weights, evaluation audio, and recognised transcripts.
# A verbatim transcript of a sermon carries the same content as the recording and the
# same obligations (docs/ASR_EVALUATION.md §7), so it is ignored here too.
__pycache__/
*.pyc
*.wav
*.safetensors

# env
.env
.env.local
.env.*.local
